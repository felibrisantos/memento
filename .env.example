# Get your free TMDB API key at https://www.themoviedb.org/settings/api
# Sign up > Settings > API > Copy "API Key (v3 auth)"
VITE_TMDB_API_KEY=your_key_here

# Supabase - create project at https://supabase.com
# Project Settings > API > Copy URL and anon/public key
VITE_SUPABASE_URL=your_project_url
VITE_SUPABASE_ANON_KEY=your_anon_key
